# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Auth custom (e-mail+senha; JWT em cookie httpOnly) ─────────
JWT_SECRET=               # segredo aleatório (ex.: openssl rand -hex 32)
PORT=3000
ADMIN_EMAIL=              # e-mail do admin criado no boot (ex.: admin@isentapcd.com.br)
ADMIN_PASSWORD=           # senha forte do admin bootstrap

# ── E-mail transacional (Resend, REST puro) ─────────────────────
RESEND_API_KEY=           # vazio = no-op com log "[email:no-op]"
EMAIL_FROM=IsentaPCD <noreply@isentapcd.com.br>

# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_APP_ID=              # espelha APP_ID para o client
